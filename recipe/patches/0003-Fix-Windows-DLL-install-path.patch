Subject: [PATCH 3/4] Fix Windows DLL install path
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Signed-off-by: Michał Górny <mgorny@gentoo.org>
---
 cmake/shared.cmake | 1 +
 1 file changed, 1 insertion(+)

diff --git a/cmake/shared.cmake b/cmake/shared.cmake
index 0433f88..4d7d2cd 100644
--- a/cmake/shared.cmake
+++ b/cmake/shared.cmake
@@ -4,6 +4,7 @@ set_target_properties(libddwaf_shared PROPERTIES OUTPUT_NAME ddwaf)
 
 install(TARGETS libddwaf_shared EXPORT libddwaf-config
     DESTINATION ${CMAKE_INSTALL_LIBDIR}
+    RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR}
     INCLUDES DESTINATION ${CMAKE_INSTALL_INCLUDEDIR})
 
 if(LINUX)
