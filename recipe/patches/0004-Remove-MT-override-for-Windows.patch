From 324a3714fa704a83314331bd8e935f4fae6d9ab5 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Micha=C5=82=20G=C3=B3rny?= <mgorny@gentoo.org>
Date: Fri, 7 Aug 2026 18:12:16 +0200
Subject: [PATCH 4/4] Remove /MT override for Windows
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Signed-off-by: Michał Górny <mgorny@gentoo.org>
---
 CMakeLists.txt | 6 ------
 1 file changed, 6 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 9c48112..153c0af 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -52,12 +52,6 @@ if(NOT MSVC)
         add_compile_options(-ggdb)
     endif()
 else()
-    if (CMAKE_BUILD_TYPE MATCHES Debug)
-        add_compile_options(/MTd)
-    else()
-        add_compile_options(/MT)
-    endif()
-
     add_compile_options(/utf-8)
     add_compile_definitions(-D_CRT_SECURE_NO_WARNINGS=1 -Dstrdup=_strdup -Dputenv=_putenv)
 endif()
